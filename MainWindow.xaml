                <TextBlock Text="Press your desired key combination below to configure the launch shortcut. You must include modifier keys (e.g. Ctrl, Alt, or Shift)."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBox x:Name="DialogHotkeyTextBox" Header="Shortcut Hotkey (Focus &amp; press keys)"
                         HorizontalAlignment="Stretch" IsReadOnly="True"/>
